DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-for-non-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://paperlens:paperlens@postgres:5432/paperlens
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
PAPERLENS_PROJECT_CHAT_LIVE_LLM=1
PAPERLENS_EMBEDDING_PROVIDER=bge-m3
PAPERLENS_EMBEDDING_MODEL=BAAI/bge-m3
PAPERLENS_EMBEDDING_DIM=1024
PAPERLENS_RAG_DENSE_K=20
PAPERLENS_RAG_LEXICAL_K=20
PAPERLENS_RAG_FINAL_K=8
PAPERLENS_RAG_RRF_K=60

# Phase 2: durable workflow (set 0 to disable; SQLite fallback defaults to 0)
PAPERLENS_DURABLE_WORKFLOW_ENABLED=1
# Phase 2 P2-GLM-01: private ingestion execution lease (both positive,
# heartbeat strictly below lease)
PAPERLENS_INGESTION_EXECUTION_LEASE_SECONDS=60
PAPERLENS_INGESTION_HEARTBEAT_SECONDS=10

VITE_API_BASE_URL=http://localhost:8000
